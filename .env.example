# ==============================================================================
# 雪花画布 (Snowflake Canvas v3) 环境变量配置模板
# 复制本文件为 .env 并根据本地环境修改：cp .env.example .env
# 注意：.env 已被加入 .gitignore，请勿将真实密钥提交至版本库！
# ==============================================================================

# 1. HTTP 服务监听配置
SNOWFLAKE_LISTEN_HOST=127.0.0.1
SNOWFLAKE_PORT=8093

# 2. 书稿正本、快照与讨论会话本地存储目录（留空则默认使用 ~/.local/share/snowflake-canvas）
SNOWFLAKE_DATA_DIR=

# 3. 本地 OpenAI 兼容推理服务配置（用于卡片讨论、AI 扩写与流程起草）
SNOWFLAKE_EXPAND_PORT=18100
CPA_BASE_URL=http://127.0.0.1:18100/v1
CPA_MODEL=deepseek-v3.2
CPA_API_KEY=your_local_gateway_api_key_here
API_SERVER_KEY=

# 4. PostgreSQL 书稿镜像与双时态叙事库配置
# 设为 1 启用 PostgreSQL 同步镜像，设为 0 则仅使用本地文件系统/内存引擎（如隔离测试环境）
SNOWFLAKE_PG_MIRROR=1
SNOWFLAKE_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/snowflake
SNOWFLAKE_PG_CONTAINER=gbrain-postgres

# 5. 双时态控制与种子脚本路径（可选，留空时回退至 ~/.hermes/scripts/ 下的默认脚本）
SNOWFLAKE_BITEMPORAL_CTL=
SNOWFLAKE_BITEMPORAL_SEED=
